[user]
	name = Leander Rodrigues
	email = me@leander.xyz
	signingkey = <INSERT_GIT_SIGNING_KEY>

[init]
	defaultBranch = main

[core]
	editor = cursor --wait

[alias]
	am = commit --amend
	amn = commit --amend --no-edit
	cb = checkout -b
	cd = checkout
	lg = log --color --graph --pretty=format:'%C(bold red)%h%Creset -%C(bold yellow)%d%Creset %s %C(bold green)(%ad) %C(bold blue)<%an>%Creset' --abbrev-commit --date=format:'%b %d, %Y'
	ls = branch
	la = !git config -l | grep alias | cut -c 7-

[commit]
	gpgsign = true

[push]
	autoSetupRemote = true

[gpg]
	format = ssh

[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
